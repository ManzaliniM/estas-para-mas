---
// src/components/Footer.astro
import { WA_NUMBER, WA_MSG } from "../data/contacto.js";
import Icon from "./Icon.astro";

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
    <div class="footer-container">
        <div class="footer-brand">
            <p class="footer-logo-text">ESTÁS PARA MÁS!!!</p>
        </div>

        <div class="footer-info">
            <h4>Ubicación</h4>
            <a
                href="https://maps.google.com/?q=Misiones+868,+Tandil"
                target="_blank"
                rel="noopener noreferrer"
                class="direccion maps-link"
            >
                <Icon name="pin" size="0.95rem" strokeWidth={2} />
                Misiones 868
            </a>
            <p>Tandil, Buenos Aires, Argentina</p>
        </div>

        <div class="footer-social">
            <h4>Contacto</h4>
            <a
                href="https://instagram.com/estasparamas"
                target="_blank"
                rel="noopener noreferrer"
                class="social-link"
            >
                <Icon name="instagram" size="1.25rem" strokeWidth={2} />
                @estasparamas
            </a>
            <a
                href={`https://wa.me/${WA_NUMBER}?text=${WA_MSG}`}
                target="_blank"
                rel="noopener noreferrer"
                class="social-link"
            >
                <Icon name="whatsapp" size="1.25rem" strokeWidth={1.8} />
                WhatsApp de Mariano
            </a>
        </div>
    </div>

    <div class="footer-bottom">
        <p>&copy; {currentYear} Estás Para Más®.</p>
    </div>
</footer>

<style>
    .site-footer {
        background-color: var(--color-background-deep);
        border-top: 1px solid var(--color-border);
        padding: 4rem 2rem 2rem 2rem;
        color: var(--color-text);
    }

    .footer-container {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1.2fr 0.9fr 0.9fr;
        gap: 3rem;
        margin-bottom: 3rem;
    }

    .footer-logo-text {
        position: relative;
        display: inline-block;
        margin-bottom: 0.75rem;
        padding-bottom: 6px;
        font-weight: 900;
        font-size: 1.35rem;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        color: var(--color-brand);
        transform: skewX(-6deg);
        transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.3, 1);
    }

    /* Barra de velocidad: misma actitud que el logo del header */
    .footer-logo-text::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: 0;
        width: 100%;
        height: 4px;
        background: linear-gradient(90deg, var(--color-brand) 0%, #ff5a2a 100%);
        transform: skewX(-30deg) scaleX(0);
        transform-origin: left;
        transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.3, 1);
    }

    .footer-logo-text:hover::after {
        transform: skewX(-30deg) scaleX(1);
    }

    .footer-logo-text:hover {
        transform: skewX(-6deg) translateX(3px);
    }

    .direccion {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        color: var(--color-text-muted);
        line-height: 1.6;
        font-size: 0.95rem;
        text-decoration: none;
        width: fit-content;
        transition: color 0.2s ease;
    }

    /* Hover: se suma el enlace a Google Maps (el pin vive en rojo fijo) */
    .maps-link:hover {
        color: var(--color-brand);
    }

    .maps-link:focus-visible {
        outline: 2px solid var(--color-brand);
        outline-offset: 4px;
    }

    /* Estilos scoped no alcanzan al svg de <Icon>: va con :global */
    .maps-link :global(svg) {
        color: var(--color-brand);
    }

    h4 {
        color: var(--color-text);
        font-size: 1.1rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 1.2rem;
        font-weight: 800;
    }

    .footer-info p {
        color: var(--color-text-muted);
        line-height: 1.6;
        font-size: var(--font-size-body);
    }

    .footer-social {
        display: flex;
        flex-direction: column;
    }

    .social-link {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        color: var(--color-text-muted);
        text-decoration: none;
        margin-bottom: 0.8rem;
        font-size: 0.95rem;
        transition:
            color 0.2s ease,
            transform 0.2s ease;
        font-weight: 600;
    }

    .social-link:hover {
        color: var(--color-brand);
        transform: translateX(4px);
    }

    /* Tamanio ya definido por atributo en <Icon> — sin CSS extra */

    .footer-bottom {
        max-width: 1200px;
        margin: 0 auto;
        border-top: 1px solid var(--color-divider);
        padding-top: 1.5rem;
        text-align: center;
    }

    .footer-bottom p {
        color: var(--color-text-subtle);
        font-size: 0.85rem;
    }

    @media (max-width: 768px) {
        .footer-container {
            grid-template-columns: 1fr;
            gap: 2rem;
        }
    }
</style>
