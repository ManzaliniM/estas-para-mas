---
// src/components/Contacto.astro
// Sección de contacto visual. Aclara que toda comunicación es directa
// con el Prof. Mariano Manzalini (sin intermediarios ni secretarias).

import Icon from "./Icon.astro";
import { WA_NUMBER, WA_MSG } from "../data/contacto.js";
---

<section id="contacto" class="contacto-section">
    <div class="contacto-container">
        <div class="contacto-intro" data-reveal>
            <span class="section-tag">CONTACTO</span>
            <h2>HABLÁ <span class="highlight">DIRECTO</span> CON MARIANO</h2>
            <p class="contacto-text">
                Acá el seguimiento es directo, sesión por sesión, desde la plaza
                hasta la meta.
                <br />Escribinos por WhatsApp o Instagram y coordinamos tu
                primer día.
            </p>
            <p class="contacto-cierre">
                Y vos... ¿estás <span class="cierre-acento">para más</span>?
            </p>
        </div>

        <div class="contacto-grid">
            <a
                href={`https://wa.me/${WA_NUMBER}?text=${WA_MSG}`}
                target="_blank"
                rel="noopener noreferrer"
                class="contacto-card"
                data-reveal
            >
                <div class="card-icon whatsapp-icon">
                    <Icon name="whatsapp" />
                </div>
                <div class="card-info">
                    <h3>WhatsApp</h3>
                    <p>
                        La vía más rápida. Coordinamos tu primer día de prueba.
                    </p>
                </div>
                <span class="card-arrow"><Icon name="arrow" /></span>
            </a>

            <a
                href="https://instagram.com/estasparamas"
                target="_blank"
                rel="noopener noreferrer"
                class="contacto-card"
                data-reveal
            >
                <div class="card-icon instagram-icon">
                    <Icon name="instagram" />
                </div>
                <div class="card-info">
                    <h3>Instagram</h3>
                    <p>Seguí el día a día del grupo en @estasparamas.</p>
                </div>
                <span class="card-arrow"><Icon name="arrow" /></span>
            </a>

            <a
                href="https://maps.google.com/?q=Misiones+868,+Tandil"
                target="_blank"
                rel="noopener noreferrer"
                class="contacto-card"
                data-reveal
            >
                <div class="card-icon ubicacion-icon">
                    <Icon name="pin" />
                </div>
                <div class="card-info">
                    <h3>Gimnasio</h3>
                    <p>No dudes en aparecer en persona en Misiones 868, Tandil.</p>
                </div>
                <span class="card-arrow"><Icon name="arrow" /></span>
            </a>
        </div>
    </div>
</section>

<style>
    .contacto-section {
        background-color: var(--color-background-deep);
        padding: 6rem 2rem;
        border-top: 1px solid var(--color-border);
        position: relative;
        overflow: hidden;
    }

    /* Acento rojo ambiental tipo spotlight */
    .contacto-section::before {
        content: "";
        position: absolute;
        top: -20%;
        left: 50%;
        transform: translateX(-50%);
        width: 700px;
        height: 700px;
        background: radial-gradient(
            circle,
            rgba(255, 42, 42, 0.1) 0%,
            transparent 60%
        );
        pointer-events: none;
    }

    .contacto-container {
        max-width: 1000px;
        margin: 0 auto;
        position: relative;
        z-index: 1;
    }

    .contacto-intro {
        text-align: center;
        margin-bottom: 3.5rem;
    }

    h2 {
        font-size: 2.6rem;
        font-weight: 900;
        text-transform: uppercase;
        margin: 0.5rem 0 1.25rem;
        line-height: 1.15;
    }

    .contacto-text {
        max-width: 640px;
        margin: 0 auto;
        color: var(--color-text-muted);
        line-height: 1.7;
        font-size: 1.05rem;
    }

    .contacto-text strong {
        color: var(--color-brand);
        font-weight: 800;
    }

    /* Cierre con la pregunta de marca */
    .contacto-cierre {
        margin: 1.5rem 0 0;
        font-size: 1.35rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--color-text);
    }

    .cierre-acento {
        color: var(--color-brand);
        display: inline-block;
        transform: skewX(-6deg);
    }

    /* ====== CARDS DE CONTACTO ====== */
    .contacto-grid {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .contacto-card {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        background-color: var(--color-surface);
        border: 1px solid var(--color-border-strong);
        border-radius: 10px;
        padding: 1.5rem 1.75rem;
        text-decoration: none;
        transition:
            transform 0.25s cubic-bezier(0.2, 0.8, 0.3, 1),
            border-color 0.25s ease,
            background-color 0.25s ease,
            opacity 0.7s cubic-bezier(0.2, 0.8, 0.3, 1);
    }

    .contacto-card:hover,
    .contacto-card:focus-visible {
        transform: translateY(-4px);
        border-color: var(--color-brand);
        background-color: var(--color-surface-raised);
    }

    .card-icon {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 54px;
        height: 54px;
        border-radius: 8px;
        transform: skewX(-6deg);
        transition:
            transform 0.25s ease,
            background-color 0.25s ease;
    }

    .card-icon :global(svg) {
        width: 1.7rem;
        height: 1.7rem;
        color: var(--color-text);
    }

    .whatsapp-icon {
        background-color: var(--color-brand);
    }

    .instagram-icon {
        background-color: var(--color-surface-raised);
        border: 1px solid var(--color-border-hover);
    }

    .ubicacion-icon {
        background-color: var(--color-surface-raised);
        border: 1px solid var(--color-border-hover);
    }

    .card-info {
        flex: 1;
    }

    .card-info h3 {
        font-size: 1.15rem;
        font-weight: 900;
        text-transform: uppercase;
        margin: 0 0 0.25rem;
        color: var(--color-text);
    }

    .card-info p {
        margin: 0;
        color: var(--color-text-muted);
        font-size: 0.92rem;
        line-height: 1.45;
    }

    .card-arrow {
        flex: 0 0 auto;
        color: var(--color-text-subtle);
        transition:
            color 0.2s ease,
            transform 0.25s ease;
    }

    .card-arrow :global(svg) {
        width: 1.4rem;
        height: 1.4rem;
    }

    .contacto-card:hover .card-arrow {
        color: var(--color-brand);
        transform: translateX(6px);
    }

    @media (max-width: 640px) {
        .contacto-section {
            padding: 4.5rem 1.25rem;
        }

        h2 {
            font-size: 1.9rem;
        }

        .contacto-card {
            padding: 1.25rem;
            gap: 1rem;
        }
    }
</style>
