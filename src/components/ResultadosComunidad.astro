---
// src/components/ResultadosComunidad.astro
// Comunidad de la carrera a la vida: prensa, entrevistas, testimonios e IG.
// El testimonio es una adaptación breve de una reflexión real publicada por
// el grupo (link al post completo). Las noticias y entrevistas se suman.

import Icon from "./Icon.astro";

// Highlights reales del perfil de Instagram
const highlights = [
    "Horarios",
    "Competencias",
    "Reconocimientos",
    "Gimnasio",
    "Trote",
    "Ciclismo",
    "Natación",
];

// Historias del grupo: notas de prensa (se van sumando más acá)
const noticias = [
    {
        medio: "El Diario de Tandil",
        titulo: "Una destacada actuación tuvieron los triatletas tandilenses que compitieron en Entre Ríos",
        url: "https://www.eldiariodetandil.com/nota-una-destaca-actuacion-tuvieron-los-triatletas-tandilenses-que-compitieron-en-entre-rios-94991",
    },
    // { medio: "...", titulo: "...", url: "..." },
];
---

<section id="resultados" class="resultados-section">
    <div class="resultados-container">
        <div class="section-header" data-reveal>
            <span class="section-tag">LA COMUNIDAD</span>
            <h2>AÑOS ACUMULANDO <span class="highlight">HISTORIAS</span></h2>
            <p>
                Noticias, entrevistas, las palabras de alumnos, y el día a día
                del grupo. Lo que no figura acá está en lo vivido, historias
                habidas y por haber. <span class="highlight">Sólo faltas vos.</span>
            </p>
        </div>

        <div class="historias-grid">
            <!-- Columna izquierda: notas de prensa -->
            <div
                class="noticias-column"
                data-reveal
                style="--reveal-delay:0.1s"
            >
                <h4 class="historias-tag">
                    <Icon name="news" size="1.1rem" /> NOTICIAS DESTACADAS
                </h4>
                {
                    noticias.map((n) => (
                        <a
                            href={n.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="historia-row"
                        >
                            <div class="historia-info">
                                <span class="historia-medio">{n.medio}</span>
                                <span class="historia-titulo">{n.titulo}</span>
                            </div>
                            <span class="row-arrow">
                                <Icon name="arrow" size="1.1rem" />
                            </span>
                        </a>
                    ))
                }

                <!-- Placeholder para próximas notas (se suman con Mariano) -->
                <div class="historia-row historia-tbd">
                    <div class="historia-info">
                        <span class="historia-medio">PRÓXIMAMENTE</span>
                        <span class="historia-titulo"
                            >Buscando notas relevantes...</span
                        >
                    </div>
                    <span class="row-arrow">
                        <Icon name="arrow" size="1.1rem" />
                    </span>
                </div>
            </div>

            <!-- Columna central: entrevista + testimonio -->
            <div class="voces-column">
                <a
                    href="https://youtu.be/Uf2OIzhVL7k"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="entrevista-card"
                    data-reveal
                    style="--reveal-delay:0.2s"
                >
                    <div class="entrevista-thumb">
                        <img
                            src="/img/entrevista-yt.jpg"
                            alt="Miniatura de la entrevista al Prof. Mariano Manzalini en YouTube"
                            loading="lazy"
                        />
                        <span class="play-badge">
                            <Icon name="video" size="1rem" /> Ver en YouTube
                        </span>
                    </div>
                    <span class="historias-tag">
                        <Icon name="video" size="1.1rem" /> ENTREVISTAS
                    </span>
                    <strong class="entrevista-titulo">
                        Métodos, valores y el triatlón.
                    </strong>
                </a>

                <!-- Testimonio: adaptación breve de la reflexión publicada por el grupo -->
                <article
                    class="testimonio-card"
                    data-reveal
                    style="--reveal-delay:0.3s"
                >
                    <span class="historias-tag">
                        <Icon name="users" size="1.1rem" /> TESTIMONIOS
                    </span>
                    <blockquote>
                        “Correr me despertó. Me devolvió una fuerza que pensé
                        que era para otros… <em
                            >cada paso es un latido más fuerte, cada kilómetro
                            una promesa que me cumplo a mí mismo.</em
                        >”
                    </blockquote>
                    <p>
                        “Y ahí aparece mi grupo, mi lugar, mi manada: EPM. Y en
                        el corazón de ese camino está Mariano, mi entrenador… el
                        que ve en mí lo que yo mismo no veo.”
                    </p>
                    <a
                        href="https://www.instagram.com/p/DRzaQMrkS8J/"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="testimonio-link"
                    >
                        Leer la reflexión completa
                        <Icon name="arrow" size="0.95rem" strokeWidth={2.2} />
                    </a>
                    <footer>Jorge Viviani</footer>
                </article>
            </div>

            <!-- Columna derecha: la comunidad en Instagram -->
            <aside
                class="comunidad-card"
                data-reveal
                style="--reveal-delay:0.25s"
            >
                <div class="comunidad-head">
                    <span class="comunidad-icon">
                        <Icon name="instagram" size="1.5rem" />
                    </span>
                    <div>
                        <h3>@ESTASPARAMAS</h3>
                    </div>
                </div>

                <div class="highlight-chips">
                    {
                        highlights.map((h) => (
                            <a
                                href="https://instagram.com/estasparamas"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="chip"
                            >
                                {h}
                            </a>
                        ))
                    }
                </div>

                <a
                    href="https://instagram.com/estasparamas"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="comunidad-cta"
                >
                    Seguir al grupo
                    <Icon name="arrow" size="1rem" strokeWidth={2.2} />
                </a>
            </aside>
        </div>
    </div>
</section>

<style>
    .resultados-section {
        background-color: var(--color-background-deep);
        padding: 6rem 2rem;
        border-top: 1px solid var(--color-border);
    }

    .resultados-container {
        max-width: 1100px;
        margin: 0 auto;
    }

    .section-header {
        text-align: center;
        margin-bottom: 3.5rem;
    }

    h2 {
        font-size: 2.6rem;
        font-weight: 900;
        text-transform: uppercase;
        margin: 0.5rem 0 1rem;
    }

    .section-header p {
        color: var(--color-text-muted);
        max-width: 560px;
        margin: 0 auto;
        line-height: 1.65;
    }

    .historias-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 1.25rem;
        align-items: start;
    }

    .noticias-column,
    .voces-column {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
    }

    .historias-tag {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--color-brand);
        font-weight: 800;
        letter-spacing: 1.8px;
        font-size: 0.78rem;
        text-transform: uppercase;
        margin-bottom: 0.25rem;
    }

    .historia-row {
        display: flex;
        align-items: center;
        gap: 1rem;
        background-color: var(--color-surface);
        border: 1px solid var(--color-border-strong);
        border-radius: 10px;
        padding: 1.1rem 1.4rem;
        color: var(--color-text);
        transition:
            transform 0.25s cubic-bezier(0.2, 0.8, 0.3, 1),
            border-color 0.25s ease,
            background-color 0.25s ease,
            opacity 0.7s cubic-bezier(0.2, 0.8, 0.3, 1);
    }

    a.historia-row {
        text-decoration: none;
    }

    .historia-row:hover {
        transform: translateX(5px);
        border-color: var(--color-brand);
        background-color: var(--color-surface-raised);
    }

    .historia-info {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        min-width: 0;
    }

    .historia-medio {
        color: var(--color-brand);
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .historia-titulo {
        color: var(--color-text-secondary);
        font-size: 0.92rem;
        line-height: 1.45;
    }

    .historia-tbd {
        border-style: dashed;
        opacity: 0.75;
    }

    /* Entrevistas (card destacada con miniatura del video) */
    .entrevista-card {
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
        background-color: var(--color-surface);
        border: 1px solid var(--color-border-strong);
        border-radius: 12px;
        padding: 1.25rem;
        text-decoration: none;
        color: var(--color-text);
        transition:
            border-color 0.25s ease,
            transform 0.25s cubic-bezier(0.2, 0.8, 0.3, 1),
            box-shadow 0.25s ease,
            opacity 0.7s cubic-bezier(0.2, 0.8, 0.3, 1);
    }

    .entrevista-card:hover {
        border-color: var(--color-brand);
        transform: translateY(-3px);
        box-shadow: 0 10px 30px var(--color-brand-shadow);
    }

    .entrevista-thumb {
        position: relative;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        border-radius: 8px;
        border: 1px solid var(--color-border-strong);
    }

    .entrevista-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(25%);
        transition:
            filter 0.3s ease,
            transform 0.4s cubic-bezier(0.2, 0.8, 0.3, 1);
    }

    .entrevista-card:hover .entrevista-thumb img {
        filter: grayscale(0%);
        transform: scale(1.04);
    }

    .play-badge {
        position: absolute;
        left: 0.75rem;
        bottom: 0.75rem;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        background-color: rgba(11, 11, 11, 0.82);
        color: var(--color-brand);
        font-weight: 800;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        padding: 0.35rem 0.7rem;
        border-radius: 100px;
        border: 1px solid rgba(255, 42, 42, 0.35);
        transition:
            background-color 0.25s ease,
            color 0.25s ease;
    }

    .entrevista-card:hover .play-badge {
        background-color: var(--color-brand);
        color: var(--color-text);
    }

    .entrevista-titulo {
        font-size: 0.95rem;
        font-weight: 700;
        line-height: 1.5;
    }

    /* Testimonios (adaptación de la reflexión de la comunidad) */
    .testimonio-card {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
        background-color: var(--color-surface);
        border: 1px solid var(--color-border-strong);
        border-radius: 12px;
        padding: 1.5rem;
        color: var(--color-text);
        transition:
            border-color 0.25s ease,
            opacity 0.7s cubic-bezier(0.2, 0.8, 0.3, 1);
    }

    .testimonio-card blockquote {
        margin: 0;
        color: var(--color-text-secondary);
        font-size: 0.95rem;
        line-height: 1.6;
    }

    .testimonio-card blockquote em {
        font-style: italic;
        color: var(--color-text);
    }

    .testimonio-card > p {
        margin: 0;
        color: var(--color-text-muted);
        font-size: 0.9rem;
        line-height: 1.6;
    }

    .testimonio-link {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        align-self: flex-start;
        color: var(--color-brand);
        text-decoration: none;
        font-weight: 800;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        transition:
            transform 0.2s ease,
            color 0.2s ease;
    }

    .testimonio-link:hover {
        transform: translateX(4px);
        color: var(--color-text);
    }

    .testimonio-card footer {
        padding-top: 0.7rem;
        border-top: 1px solid var(--color-divider);
        color: var(--color-text-subtle);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.8px;
        text-transform: uppercase;
    }

    /* Card IG / comunidad */
    .comunidad-card {
        background:
            radial-gradient(
                circle at 50% 0%,
                rgba(255, 42, 42, 0.14) 0%,
                transparent 55%
            ),
            var(--color-surface);
        border: 1px solid var(--color-border-strong);
        border-radius: 12px;
        padding: 1.75rem;
        display: flex;
        flex-direction: column;
        gap: 1.4rem;
        transition:
            border-color 0.25s ease,
            transform 0.25s cubic-bezier(0.2, 0.8, 0.3, 1),
            opacity 0.7s cubic-bezier(0.2, 0.8, 0.3, 1);
    }

    .comunidad-card:hover {
        border-color: var(--color-border-hover);
        transform: translateY(-3px);
    }

    .comunidad-head {
        display: flex;
        align-items: center;
        gap: 0.9rem;
    }

    .comunidad-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 50px;
        height: 50px;
        border-radius: 8px;
        color: var(--color-text);
        background-color: var(--color-surface-raised);
        border: 1px solid var(--color-border-hover);
    }

    .comunidad-head h3 {
        font-size: 1.1rem;
        font-weight: 900;
        text-transform: uppercase;
        margin: 0;
    }

    .comunidad-head p {
        color: var(--color-text-muted);
        font-size: 0.85rem;
        margin: 0.15rem 0 0;
    }

    .highlight-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .chip {
        color: var(--color-text-muted);
        text-decoration: none;
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border: 1px solid var(--color-border-hover);
        background-color: var(--color-background-deep);
        padding: 0.4rem 0.75rem;
        border-radius: 100px;
        transition:
            color 0.2s ease,
            border-color 0.2s ease,
            transform 0.2s ease;
    }

    .chip:hover {
        color: var(--color-brand);
        border-color: var(--color-brand);
        transform: translateY(-2px);
    }

    .comunidad-cta {
        margin-top: auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        background-color: var(--color-brand);
        color: var(--color-text);
        text-decoration: none;
        font-weight: 800;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
        padding: 0.85rem 1.5rem;
        border-radius: 4px;
        transition:
            background-color 0.2s,
            transform 0.2s,
            box-shadow 0.2s;
    }

    .comunidad-cta:hover {
        background-color: var(--color-brand-hover);
        transform: translateY(-2px);
        box-shadow: 0 8px 22px var(--color-brand-shadow);
    }

    /* ====== RESPONSIVE ====== */
    @media (max-width: 980px) {
        .historias-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    @media (max-width: 640px) {
        .resultados-section {
            padding: 4.5rem 1.25rem;
        }

        h2 {
            font-size: 1.9rem;
        }

        .historias-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
