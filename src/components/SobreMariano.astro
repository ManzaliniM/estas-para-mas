---
// src/components/SobreMariano.astro
import Icon from "./Icon.astro";
import { Image } from "astro:assets";
import marianoImg from "../assets/mariano.jpg";
---

<section id="sobre-mariano" class="about-section">
    <div class="about-container">
        <div class="about-visual" data-reveal>
            <div class="frame-container">
                <Image
                    src={marianoImg}
                    alt="Prof. Mariano Manzalini corriendo los 42K de Rosario; entrenador de running y triatlón en Tandil"
                    widths={[480, 720, 960]}
                    sizes="(max-width: 968px) 92vw, 46vw"
                    loading="lazy"
                />
                <!-- Velo: funde la foto con el fondo (sin marco) -->
                <div class="border-effect" aria-hidden="true"></div>
            </div>
        </div>

        <div class="about-content" data-reveal>
            <span class="section-tag">EL ENTRENADOR</span>
            <h2>MARIANO <span class="highlight">MANZALINI</span></h2>
            <p class="lead">
                El objetivo de Mariano no es solo entrenar: es enseñar a cada
                uno a superar sus propios límites de forma inteligente y
                segura.
            </p>

            <!-- Stat migrado del hero: el dato de trayectoria pertenece acá -->
            <div class="trayectoria-strip">
                <span class="trayectoria-numero">33+</span>
                <p class="trayectoria-texto">
                    Años de trayectoria<br />formando en Tandil
                </p>
            </div>

            <!-- Credenciales al pie de la bio (la foto ahora destaca sola) -->
            <div class="credenciales">
                <div class="credencial-item">
                    <span class="credencial-icon">
                        <Icon name="grad" size="1.4rem" strokeWidth={1.8} />
                    </span>
                    <p>
                        Prof. Universitario <br /><strong
                            >UNLP (Educación Física)</strong
                        >
                    </p>
                </div>
                <div class="credencial-item">
                    <span class="credencial-icon">
                        <Icon name="bike" size="1.4rem" strokeWidth={1.8} />
                    </span>
                    <p>
                        Entrenador Certificado <br /><strong
                            >ITU (Triatlón)</strong
                        >
                    </p>
                </div>
            </div>

            <div class="quote-box">
                <p class="quote-principal">Lo importante es compartir.</p>
            </div>
        </div>
    </div>
</section>

<style>
    .about-section {
        background-color: var(--color-background);
        padding: 6rem 2rem;
        border-top: 1px solid var(--color-border);
    }
    .about-container {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 0.95fr 1.05fr;
        gap: 3rem;
        align-items: start;
    }
    /* La columna visual es solo la foto, flotando centrada respecto de
       la bio: los datos acompañantes (credenciales, quote) viven a la
       derecha para que la imagen sea el protagonista absoluto */
    .about-visual {
        position: relative;
        align-self: center;
    }
    /* Sin marco: la foto no es un recuadro, es un bloque que se funde
       con el fondo por sus cuatro bordes (el velo de .border-effect
       hace el trabajo). overflow: hidden solo recorta el zoom leve. */
    .frame-container {
        position: relative;
        overflow: hidden;
    }
    .frame-container :global(img) {
        width: 100%;
        height: clamp(340px, 39vw, 520px);
        object-fit: cover;
        transform: scale(1.06);
        /* Tratamiento del hero: desaturada y sobria, para integrarse */
        filter: grayscale(28%) brightness(0.85) contrast(1.06);
    }

    /* Velo de integración estilo hero: en cada borde la foto se va a
       #0b0b0b (el color del fondo), así no se percibe ningún borde
       duro. Arriba a la derecha queda un aura roja de marca muy sutil. */
    .border-effect {
        position: absolute;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        background:
            radial-gradient(
                circle at 85% 6%,
                rgba(255, 42, 42, 0.14) 0%,
                transparent 42%
            ),
            linear-gradient(
                90deg,
                rgba(11, 11, 11, 0.95) 0%,
                transparent 22%,
                transparent 78%,
                rgba(11, 11, 11, 0.95) 100%
            ),
            linear-gradient(
                0deg,
                rgba(11, 11, 11, 0.9) 0%,
                transparent 26%,
                transparent 78%,
                rgba(11, 11, 11, 0.82) 100%
            );
    }
    .about-content {
        color: var(--color-text);
    }
    h2 {
        font-size: var(--font-size-section-heading);
        font-weight: 900;
        margin: 0.5rem 0 1.5rem 0;
    }
    .lead {
        font-size: 1.2rem;
        color: var(--color-text);
        font-weight: 600;
        line-height: 1.5;
        margin-bottom: 1.5rem;
    }
    /* Stat de trayectoria (llegó del hero): número protagonista + tag */
    .trayectoria-strip {
        display: flex;
        align-items: center;
        gap: 1.1rem;
        margin-top: 0.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--color-border-strong);
        max-width: 420px;
    }

    .trayectoria-numero {
        font-size: 3.2rem;
        font-weight: 900;
        color: var(--color-brand);
        line-height: 1;
        letter-spacing: -1px;
        display: inline-block;
        transform: skewX(-6deg);
    }

    .trayectoria-texto {
        margin: 0;
        font-size: 0.82rem;
        line-height: 1.45;
        color: var(--color-text-muted);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* Credenciales al pie de la bio: sin divisor propio — el strip de
       trayectoria ya corta arriba; esta franja es una continuación */
    .credenciales {
        display: flex;
        gap: 2rem;
        flex-wrap: wrap;
        margin: 2.4rem 0 0;
    }

    .credencial-item {
        display: flex;
        align-items: center;
        gap: 0.8rem;
    }

    .credencial-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 46px;
        height: 46px;
        color: var(--color-brand);
        background-color: var(--color-surface-raised);
        border-radius: 6px;
        border: 1px solid var(--color-border-strong);
        transform: skewX(-6deg);
        transition:
            border-color 0.25s ease,
            background-color 0.25s ease,
            color 0.25s ease;
    }

    .credencial-item:hover .credencial-icon {
        border-color: var(--color-brand);
        background-color: var(--color-brand);
        color: var(--color-text);
    }

    .credencial-item p {
        font-size: 0.85rem;
        line-height: 1.35;
        margin: 0;
        color: var(--color-text-muted);
    }

    .credencial-item strong {
        color: var(--color-text);
    }

    @media (max-width: 500px) {
        .credenciales {
            gap: 1.25rem;
        }
    }
    .quote-box {
        border-left: 4px solid var(--color-brand);
        padding-left: 1.5rem;
        background-color: var(--color-surface);
        padding: 1.5rem;
        border-radius: 0 8px 8px 0;
        margin-top: 1.75rem;
    }
    .quote-principal {
        font-weight: 800;
        font-size: 1.3rem;
        line-height: 1.35;
        color: var(--color-text);
        margin: 0 0 0.6rem;
    }

    @media (max-width: 968px) {
        .about-container {
            grid-template-columns: 1fr;
            gap: 3rem;
        }
    }
</style>
