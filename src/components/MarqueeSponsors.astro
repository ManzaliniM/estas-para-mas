---
// src/components/MarqueeSponsors.astro
// Marquee infinito de sponsors al pie de la página.
// Solo CSS (con duplicado del track para el loop seamless) + pausa al hover.
// Reemplazá los placeholders "..." cuando tengas los logos reales.

import Icon from "./Icon.astro";
import { WA_NUMBER, WA_MSG } from "../data/contacto.js";

const sponsors = [
    { name: "HASHTAG STORE", url: "https://www.hashtagstore.com.ar/" },
    { name: "TU MARCA" },
    { name: "TU MARCA" },
    { name: "TU MARCA" },
    { name: "TU MARCA" },
];
---

<section class="sponsors-section" aria-label="Sponsors">
    <div class="sponsors-header">
        <span class="sponsors-tag">EL GRUPO LOS LLEVA PUESTOS</span>
    </div>

    <div class="marquee">
        <div class="marquee-track">
            {
                sponsors.map((s) =>
                    s.url ? (
                        <a
                            href={s.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="sponsor-item sponsor-link"
                        >
                            {s.name}
                        </a>
                    ) : (
                        <span class="sponsor-item">{s.name}</span>
                    )
                )
            }
            {/* Duplicado para el loop infinito (decorativo, no tabbable) */}
            {
                sponsors.map((s) =>
                    s.url ? (
                        <a
                            href={s.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="sponsor-item sponsor-link"
                            aria-hidden="true"
                            tabindex="-1"
                        >
                            {s.name}
                        </a>
                    ) : (
                        <span class="sponsor-item" aria-hidden="true">
                            {s.name}
                        </span>
                    )
                )
            }
        </div>
    </div>

    <!-- Invitación a ser sponsor -->
    <div class="sponsor-cta" data-reveal>
        <h3>¿TU MARCA QUIERE ACERCARSE?</h3>
        <p>
            Nuestra comunidad lleva años creciendo junto a cientos de deportistas
            entrenando por las sierras, compartiendo una identidad, objetivos y experiencias.
        </p>
        <span>Te invitamos a sumarte como sponsor y acompañar nuestro camino.</span>
        <a
            href={`https://wa.me/${WA_NUMBER}?text=${WA_MSG}`}
            target="_blank"
            rel="noopener noreferrer"
        >
            Conversar por WhatsApp
            <Icon name="arrow" size="1rem" strokeWidth={2.2} />
        </a>
    </div>
</section>

<style>
    .sponsors-section {
        background-color: var(--color-background-deep);
        padding: 3rem 0 3.5rem;
        border-top: 1px solid var(--color-border);
        overflow: hidden;
    }

    .sponsors-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .sponsors-tag {
        color: var(--color-text-subtle);
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 3px;
        text-transform: uppercase;
    }

    /* ====== MARQUEE ====== */
    .marquee {
        position: relative;
        display: flex;
        max-width: 100vw;
        -webkit-mask-image: linear-gradient(
            90deg,
            transparent,
            #000 12%,
            #000 88%,
            transparent
        );
        mask-image: linear-gradient(
            90deg,
            transparent,
            #000 12%,
            #000 88%,
            transparent
        );
    }

    .marquee-track {
        display: flex;
        align-items: center;
        flex: 0 0 auto;
        animation: marquee 28s linear infinite;
    }

    /* Pausa al pasar el mouse (para apreciar / clickear) */
    .marquee:hover .marquee-track {
        animation-play-state: paused;
    }

    @keyframes marquee {
        from {
            transform: translateX(0);
        }
        to {
            /* El track lleva la lista duplicada: -50% = una copia exacta */
            transform: translateX(-50%);
        }
    }

    .sponsor-item {
        flex: 0 0 auto;
        margin-right: 5rem;
        font-size: 1.5rem;
        font-weight: 900;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--color-text-subtle);
        white-space: nowrap;
        transform: skewX(-6deg);
        transition: color 0.25s ease;
        cursor: default;
    }

    /* Los sponsors con link son clickeables */
    .sponsor-link {
        text-decoration: none;
        cursor: pointer;
    }

    .sponsor-link:focus-visible {
        outline: 2px solid var(--color-brand);
        outline-offset: 4px;
    }

    /* Sponsor principal: HASHTAG STORE (siempre visible en brand) */
    .sponsor-item:first-child,
    .sponsor-item:nth-last-child(5) {
        color: var(--color-brand);
    }

    .sponsor-item:hover {
        color: var(--color-text);
    }

    @media (prefers-reduced-motion: reduce) {
        .marquee-track {
            animation: none;
            flex-wrap: wrap;
            justify-content: center;
            padding: 0 1rem;
            gap: 2.5rem;
        }
    }

    @media (max-width: 640px) {
        .sponsor-item {
            font-size: 1.1rem;
        }
    }

    /* ====== INVITACIÓN A SER SPONSOR ====== */
    .sponsor-cta {
        max-width: 720px;
        margin: 3.5rem auto 0;
        padding: 1.75rem 2rem;
        text-align: center;
        border: 1px solid var(--color-border-strong);
        border-top: 3px solid var(--color-brand);
        border-radius: 10px;
        background-color: rgba(255, 42, 42, 0.04);
    }

    .sponsor-cta h3 {
        font-size: 1.15rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin: 0 0 0.6rem;
    }

    .sponsor-cta p {
        color: var(--color-text-muted);
        font-size: 0.92rem;
        line-height: 1.65;
        margin: 0 0 1.2rem;
    }

    .sponsor-cta span {
        color: var(--color-text);
        font-size: 1rem;
    }

    .sponsor-cta a {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        color: var(--color-brand);
        text-decoration: none;
        font-weight: 800;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border: 1px solid rgba(255, 42, 42, 0.35);
        padding: 0.65rem 1.3rem;
        border-radius: 4px;
        margin-top: 1.2rem;
        transition:
            background-color 0.2s ease,
            color 0.2s ease,
            border-color 0.2s ease;
    }

    .sponsor-cta a:hover {
        background-color: var(--color-brand);
        color: var(--color-text);
        border-color: var(--color-brand);
    }
</style>
