---
// src/components/Hero.astro
import Icon from "./Icon.astro";
import { Image } from "astro:assets";
import heroImg from "../assets/hero.jpg";
import { WA_NUMBER, WA_MSG } from "../data/contacto.js";
---

<section class="hero">
    <!-- Foto integrada como fondo del hero completo (optimizada a WebP por Astro) -->
    <div class="hero-bg" aria-hidden="true">
        <Image
            src={heroImg}
            alt=""
            widths={[1280, 1600, 1920]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high" />
        <div class="hero-bg-overlay"></div>
    </div>

    <div class="hero-container">
        <div class="hero-content">
            <!-- Credencial/Badge local superior -->
            <span class="hero-badge">GRUPO DE ENTRENAMIENTO</span>

            <h1 class="hero-titulo">
                <span class="linea-titulo">ESTÁS</span>
                <span class="linea-titulo">PARA</span>
                <span class="linea-titulo linea-acento">MÁS!!!</span>
            </h1>

            <!-- contexto -->
            <p class="hero-description">
                Entrenamiento multidisciplinario coordinado por <strong
                    >Mariano Manzalini</strong
                >. <br />Encontrá tu ritmo, cumplí tus objetivos.
            </p>

            <!-- Llamados a la Acción (CTAs) -->
            <div class="hero-actions">
                <a
                    href={`https://wa.me/${WA_NUMBER}?text=${WA_MSG}`}
                    class="btn btn-cta-primary"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    ¡Sumate a entrenar hoy!
                </a>
                <a href="#actividades" class="btn btn-cta-secondary"
                    >Ver actividades</a
                >
            </div>

            <!-- Franja de estadísticas de impacto -->
            <div class="hero-stats">
                <div class="stat-item">
                    <span class="stat-number">33+</span>
                    <span class="stat-label">Años de<br />trayectoria</span>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* ====== ESTILOS LOCALES PARA EL HERO ====== */
    .hero {
        background-color: var(--color-background);
        color: var(--color-text);
        min-height: 82vh;
        display: flex;
        align-items: center;
        padding: 4rem 2rem;
        overflow: hidden;
        position: relative;
        font-family:
            system-ui,
            -apple-system,
            sans-serif;
    }

    .hero-container {
        max-width: 65%;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr;
        gap: 3.5rem;
        align-items: center;
        width: 100%;
        position: relative;
        z-index: 2;
    }

    /* ====== FONDO FOTOGRÁFICO DEL HERO ====== */
    .hero-bg {
        position: absolute;
        inset: 0;
        z-index: 0;
        overflow: hidden;
    }

    .hero-bg :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 20%;
        filter: grayscale(30%) brightness(0.6) contrast(1.05);
        /* Zoom lento de entrada: la foto "respira" */
        animation: herozoom 20s ease-out forwards;
    }

    @keyframes herozoom {
        from {
            transform: scale(1);
        }
        to {
            transform: scale(1.08);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-bg :global(img) {
            animation: none;
        }
    }

    /* Veladuras para que el texto mande: oscura a la izquierda + apoyo inferior */
    .hero-bg-overlay {
        position: absolute;
        inset: 0;
        background:
            linear-gradient(
                90deg,
                rgba(11, 11, 11, 0.96) 0%,
                rgba(11, 11, 11, 0.82) 40%,
                rgba(11, 11, 11, 0.45) 78%,
                rgba(11, 11, 11, 0.3) 100%
            ),
            linear-gradient(
                0deg,
                rgba(11, 11, 11, 0.85) 0%,
                transparent 35%
            );
    }

    /* Contenido Izquierdo (Textos) */
    .hero-content {
        display: flex;
        flex-direction: column;
        z-index: 2;
    }

    .hero-badge {
        color: var(--color-brand); /* Rojo vibrante de la marca */
        font-size: 0.85rem;
        font-weight: 800;
        letter-spacing: 2px;
        margin-bottom: 1rem;
        text-transform: uppercase;
    }

    .hero-titulo {
        /* Apilado: más chico en pantallas chicas, bien grande en desktop */
        font-size: clamp(3rem, 6.5vw, 5.5rem);
        font-weight: 900;
        line-height: 0.95;
        margin: 0 0 1.75rem 0;
        letter-spacing: -2px;
        color: var(--color-text);
        /* Efecto itálico agresivo simulando velocidad/deporte */
        transform: skewX(-6deg);
    }

    .linea-titulo {
        display: block;
        transition:
            transform 0.35s cubic-bezier(0.2, 0.8, 0.3, 1),
            letter-spacing 0.35s ease;
    }

    /* La palabra clave vive en rojo de marca */
    .linea-acento {
        color: var(--color-brand);
    }

    /* Hover: la pila "toma impulso" — cada línea acelera un poco más */
    .hero-titulo:hover .linea-titulo:nth-child(1) {
        transform: translateX(4px);
    }
    .hero-titulo:hover .linea-titulo:nth-child(2) {
        transform: translateX(10px);
    }
    .hero-titulo:hover .linea-titulo:nth-child(3) {
        transform: translateX(16px);
        letter-spacing: 1px;
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-titulo:hover .linea-titulo {
            transform: none;
        }
    }

    .hero-description {
        font-size: 1.15rem;
        line-height: 1.6;
        color: var(--color-text-secondary);
        margin-bottom: 2.5rem;
        max-width: 100%;
    }

    .hero-description strong {
        color: var(--color-text);
    }

    /* Botones de Acción */
    .hero-actions {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 3.5rem;
    }

    .btn {
        padding: 1rem 2rem;
        font-weight: 700;
        text-decoration: none;
        text-transform: uppercase;
        font-size: 0.95rem;
        border-radius: 4px;
        transition: all 0.2s ease-in-out;
        text-align: center;
    }

    .btn-cta-primary {
        background-color: var(--color-brand);
        color: var(--color-text);
    }

    .btn-cta-primary:hover {
        background-color: var(--color-brand-hover);
        transform: translateY(-2px);
        box-shadow: 0 4px 15px var(--color-brand-shadow);
        /* transform: skewX(-6deg) scale(1.05); */
    }

    .btn-cta-secondary {
        background-color: transparent;
        color: var(--color-text);
        border: 2px solid var(--color-text);
    }

    .btn-cta-secondary:hover {
        background-color: var(--color-text);
        color: var(--color-background);
        transform: translateY(-2px);
        /* transform: skewX(-6deg) scale(1.05); */
    }

    /* Franja de estadísticas de impacto */
    .hero-stats {
        display: flex;
        align-items: center;
        gap: 2rem;
        border-top: 1px solid var(--color-border-strong);
        padding-top: 2rem;
    }

    .stat-item {
        display: flex;
        align-items: center;
        gap: 0.8rem;
    }

    .stat-number {
        font-size: 2.4rem;
        font-weight: 900;
        color: var(--color-brand);
        line-height: 1;
        letter-spacing: -1px;
        display: inline-block;
        transform: skewX(-6deg);
    }

    .stat-label {
        font-size: 0.78rem;
        line-height: 1.35;
        color: var(--color-text-muted);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .stat-divider {
        width: 1px;
        height: 44px;
        background-color: var(--color-border-strong);
    }

    /* ====== RESPONSIVE (Celulares) ====== */
    @media (max-width: 968px) {
        .hero {
            padding: 2rem 1rem;
        }

        .hero-container {
            grid-template-columns: 1fr;
            gap: 2rem;
            max-width: 100%;
        }

        /* En mobile el texto ocupa todo el ancho: veladura pareja */
        .hero-bg-overlay {
            background: rgba(11, 11, 11, 0.82);
        }

        .hero-actions {
            flex-direction: column;
            width: 100%;
        }

        .btn {
            width: 100%;
        }

        .hero-stats {
            flex-wrap: wrap;
            gap: 1.25rem;
            row-gap: 1.25rem;
        }

        .stat-divider {
            display: none;
        }

        .stat-number {
            font-size: 1.8rem;
        }
    }
</style>
