---
// src/components/Comunidad.astro
// La comunidad: prensa, entrevistas, testimonios propios e Instagram.
// El testimonio es una adaptación breve de una reflexión real publicada por
// el grupo (link al post completo). Las noticias y entrevistas se suman.

import Icon from "./Icon.astro";
import { Image } from "astro:assets";
import entrevistaImg from "../assets/entrevista-yt.jpg";
import { WA_NUMBER, WA_MSG_TESTIMONIOS } from "../data/contacto.js";

// Link de WhatsApp con mensaje precargado para compartir testimonios
// (encodeURIComponent corre en build, no en el navegador).
const WA_TESTIMONIOS_URL = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(
    WA_MSG_TESTIMONIOS,
)}`;

// Highlights reales del perfil de Instagram
const highlights = [
    "Horarios",
    "Competencias",
    "Reconocimientos",
    "Gimnasio",
    "Trote",
    "Ciclismo",
    "Natación",
];

// Historias del grupo: notas de prensa (se van sumando más acá)
const noticias = [
    {
        medio: "El Diario de Tandil",
        fecha: "27/04/2023",
        titulo: "Una destacada actuación tuvieron los triatletas tandilenses que compitieron en Entre Ríos",
        url: "https://www.eldiariodetandil.com/nota-una-destaca-actuacion-tuvieron-los-triatletas-tandilenses-que-compitieron-en-entre-rios-94991",
    },
    {
        medio: "El Diario de Tandil",
        fecha: "11/01/2023",
        titulo: "El team \"Estás Para Más\" tendrá representación en el Ironman de Finlandia",
        url: "https://www.eldiariodetandil.com/nota-el-team-estas-para-mas-tendra-representacion-en-el-ironman-de-finlandia--94169",
    },
    // { medio: "...", titulo: "...", url: "..." },
];
---

<section id="comunidad" class="resultados-section">
    <div class="resultados-container">
        <div class="section-header" data-reveal>
            <span class="section-tag">LA COMUNIDAD</span>
            <h2>AÑOS ACUMULANDO <span class="highlight">HISTORIAS</span></h2>
            <p>
                Noticias, entrevistas, las palabras de alumnos, y el día a día
                del grupo. Lo que no figura acá está en lo vivido, historias
                habidas y por haber. <span class="highlight">Sólo faltas vos.</span>
            </p>
        </div>

        <!-- Fila superior: prensa + entrevista (la pieza mayor, al costado) -->
        <div class="historias-top">
            <!-- Notas de prensa -->
            <div
                class="noticias-column"
                data-reveal
                style="--reveal-delay:0.1s"
            >
                <h4 class="historias-tag">
                    <Icon name="news" size="1.1rem" /> NOTICIAS DESTACADAS
                </h4>
                {
                    noticias.map((n) => (
                        <a
                            href={n.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="historia-row"
                        >
                            <div class="historia-info">
                                <span class="historia-medio"
                                    >{n.medio}<span class="historia-fecha"
                                        >{n.fecha}</span
                                    ></span
                                >
                                <span class="historia-titulo">{n.titulo}</span>
                            </div>
                            <span class="row-arrow">
                                <Icon name="arrow" size="1.1rem" />
                            </span>
                        </a>
                    ))
                }
            </div>

            <!-- Entrevista: la pieza audiovisual de la sección -->
            <a
                href="https://youtu.be/Uf2OIzhVL7k"
                target="_blank"
                rel="noopener noreferrer"
                class="entrevista-card"
                data-reveal
                style="--reveal-delay:0.2s"
            >
                <div class="entrevista-thumb">
                    <Image
                        src={entrevistaImg}
                        alt="Miniatura de la entrevista al Prof. Mariano Manzalini en YouTube"
                        width={480}
                        loading="lazy"
                    />
                    <span class="play-badge">
                        <Icon name="video" size="1rem" /> Ver en YouTube
                    </span>
                </div>
                <span class="historias-tag">
                    <Icon name="video" size="1.1rem" /> ENTREVISTAS
                </span>
                <strong class="entrevista-titulo">
                    Santiago Cataldo y Mariano Manzalini — Iron Man Triatlón
                    Entre Ríos 2025.
                </strong>
                <span class="entrevista-meta">
                    Conducida por Hugo Alberto Rodríguez · Cataldo se consagró
                    con 9h20; Mariano, preparador de los campeones, cerró 20°
                    general con 11h22.
                </span>
            </a>
        </div>

        <!-- Grilla de testimonios: cada historia nueva suma una celda
             horizontal (la sección crece por filas, no por columnas) -->
        <div class="testimonios-grid" data-reveal style="--reveal-delay:0.15s">
            <!-- Testimonio: adaptación breve de la reflexión publicada por el grupo -->
            <article class="testimonio-card">
                <span class="historias-tag">
                    <Icon name="users" size="1.1rem" /> TESTIMONIOS
                </span>
                <blockquote>
                    “Correr me despertó. Me devolvió una fuerza que pensé que
                    era para otros… <em
                        >cada paso es un latido más fuerte, cada kilómetro una
                        promesa que me cumplo a mí mismo.</em
                    >”
                </blockquote>
                <p>
                    “Y ahí aparece mi grupo, mi lugar, mi manada: EPM. Y en el
                    corazón de ese camino está Mariano, mi entrenador… el que
                    ve en mí lo que yo mismo no veo.”
                </p>
                <a
                    href="https://www.instagram.com/p/DRzaQMrkS8J/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="testimonio-link"
                >
                    Leer la reflexión completa
                    <Icon name="arrow" size="0.95rem" strokeWidth={2.2} />
                </a>
                <footer>Jorge Viviani</footer>
            </article>

            <!-- Nuevos testimonios se suman acá como <article class="testimonio-card"> -->
        </div>

        <!-- CTA central estilo "¿tu marca quiere acercarse?": convocatoria
             para que los alumnos sumen su historia -->
        <div class="compartir-band" data-reveal style="--reveal-delay:0.25s">
            <span class="historias-tag">
                <Icon name="users" size="1.1rem" /> TU HISTORIA
            </span>
            <h3>¿QUERÉS COMPARTIR TU EXPERIENCIA?</h3>
            <p>
                Si entrenás o entrenaste con nosotros y el grupo te marcó algo,
                contanos: leemos con atención cada historia y la sumamos a esta
                sección con tu nombre.
            </p>
            <a
                href={WA_TESTIMONIOS_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="compartir-cta"
            >
                <Icon name="whatsapp" size="1rem" />
                Escribinos por WhatsApp
            </a>
        </div>

        <!-- Banner de cierre: la comunidad en Instagram -->
        <aside class="comunidad-card" data-reveal style="--reveal-delay:0.3s">
            <div class="comunidad-head">
                <span class="comunidad-icon">
                    <Icon name="instagram" size="1.5rem" />
                </span>
                <div>
                    <h3>@ESTASPARAMAS</h3>
                </div>
            </div>

            <div class="highlight-chips">
                {
                    highlights.map((h) => (
                        <a
                            href="https://instagram.com/estasparamas"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="chip"
                        >
                            {h}
                        </a>
                    ))
                }
            </div>

            <a
                href="https://instagram.com/estasparamas"
                target="_blank"
                rel="noopener noreferrer"
                class="comunidad-cta"
            >
                Seguir al grupo
                <Icon name="arrow" size="1rem" strokeWidth={2.2} />
            </a>
        </aside>
    </div>
</section>

<style>
    .resultados-section {
        background-color: var(--color-background-deep);
        padding: 6rem 2rem;
        border-top: 1px solid var(--color-border);
    }

    .resultados-container {
        max-width: 1100px;
        margin: 0 auto;
    }

    .section-header {
        text-align: center;
        margin-bottom: 3.5rem;
    }

    h2 {
        font-size: 2.6rem;
        font-weight: 900;
        text-transform: uppercase;
        margin: 0.5rem 0 1rem;
    }

    .section-header p {
        color: var(--color-text-muted);
        max-width: 560px;
        margin: 0 auto;
        line-height: 1.65;
    }

    /* Fila superior: prensa + entrevista, dos columnas pareja */
    .historias-top {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
        align-items: start;
    }

    .noticias-column {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
    }

    /* Grilla de testimonios: cada historia nueva ocupa una celda y las
       filas crecen horizontalmente — la sección nunca queda desproporcionada */
    .testimonios-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.25rem;
        align-items: start;
        margin-top: 1.5rem;
    }

    .historias-tag {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--color-brand);
        font-weight: 800;
        letter-spacing: 1.8px;
        font-size: 0.78rem;
        text-transform: uppercase;
        margin-bottom: 0.25rem;
    }

    .historia-row {
        display: flex;
        align-items: center;
        gap: 1rem;
        background-color: var(--color-surface);
        border: 1px solid var(--color-border-strong);
        border-radius: 10px;
        padding: 1.1rem 1.4rem;
        color: var(--color-text);
        transition:
            transform 0.25s cubic-bezier(0.2, 0.8, 0.3, 1),
            border-color 0.25s ease,
            background-color 0.25s ease,
            opacity 0.7s cubic-bezier(0.2, 0.8, 0.3, 1);
    }

    a.historia-row {
        text-decoration: none;
    }

    .historia-row:hover {
        transform: translateX(5px);
        border-color: var(--color-brand);
        background-color: var(--color-surface-raised);
    }

    .historia-info {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        min-width: 0;
    }

    .historia-medio {
        color: var(--color-brand);
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    /* Fecha de la nota, acompañando al medio */
    .historia-fecha {
        margin-left: 0.75rem;
        color: var(--color-text-subtle);
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .historia-titulo {
        color: var(--color-text-secondary);
        font-size: 0.92rem;
        line-height: 1.45;
    }

    /* Entrevistas (card destacada con miniatura del video) */
    .entrevista-card {
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
        background-color: var(--color-surface);
        border: 1px solid var(--color-border-strong);
        border-radius: 12px;
        padding: 1.25rem;
        text-decoration: none;
        color: var(--color-text);
        transition:
            border-color 0.25s ease,
            transform 0.25s cubic-bezier(0.2, 0.8, 0.3, 1),
            box-shadow 0.25s ease,
            opacity 0.7s cubic-bezier(0.2, 0.8, 0.3, 1);
    }

    .entrevista-card:hover {
        border-color: var(--color-brand);
        transform: translateY(-3px);
        box-shadow: 0 10px 30px var(--color-brand-shadow);
    }

    .entrevista-thumb {
        position: relative;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        border-radius: 8px;
        border: 1px solid var(--color-border-strong);
    }

    .entrevista-thumb :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(25%);
        transition:
            filter 0.3s ease,
            transform 0.4s cubic-bezier(0.2, 0.8, 0.3, 1);
    }

    .entrevista-card:hover .entrevista-thumb :global(img) {
        filter: grayscale(0%);
        transform: scale(1.04);
    }

    .play-badge {
        position: absolute;
        left: 0.75rem;
        bottom: 0.75rem;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        background-color: rgba(11, 11, 11, 0.82);
        color: var(--color-brand);
        font-weight: 800;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        padding: 0.35rem 0.7rem;
        border-radius: 100px;
        border: 1px solid rgba(255, 42, 42, 0.35);
        transition:
            background-color 0.25s ease,
            color 0.25s ease;
    }

    .entrevista-card:hover .play-badge {
        background-color: var(--color-brand);
        color: var(--color-text);
    }

    .entrevista-titulo {
        font-size: 0.95rem;
        font-weight: 700;
        line-height: 1.5;
    }

    /* Bajo el título: quién conduce + resumen del resultado */
    .entrevista-meta {
        font-size: 0.78rem;
        line-height: 1.55;
        color: var(--color-text-muted);
    }

    .entrevista-card:hover .entrevista-meta {
        color: var(--color-text-secondary);
    }

    /* Testimonios (adaptación de la reflexión de la comunidad) */
    .testimonio-card {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
        background-color: var(--color-surface);
        border: 1px solid var(--color-border-strong);
        border-radius: 12px;
        padding: 1.5rem;
        color: var(--color-text);
        transition:
            border-color 0.25s ease,
            opacity 0.7s cubic-bezier(0.2, 0.8, 0.3, 1);
    }

    .testimonio-card blockquote {
        margin: 0;
        color: var(--color-text-secondary);
        font-size: 0.95rem;
        line-height: 1.6;
    }

    .testimonio-card blockquote em {
        font-style: italic;
        color: var(--color-text);
    }

    .testimonio-card > p {
        margin: 0;
        color: var(--color-text-muted);
        font-size: 0.9rem;
        line-height: 1.6;
    }

    .testimonio-link {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        align-self: flex-start;
        color: var(--color-brand);
        text-decoration: none;
        font-weight: 800;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        transition:
            transform 0.2s ease,
            color 0.2s ease;
    }

    .testimonio-link:hover {
        transform: translateX(4px);
        color: var(--color-text);
    }

    .testimonio-card footer {
        padding-top: 0.7rem;
        border-top: 1px solid var(--color-divider);
        color: var(--color-text-subtle);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.8px;
        text-transform: uppercase;
    }

    /* Banda central de apoyo: mismo patrón del "¿tu marca quiere
       acercarse?" de los sponsors (borde superior rojo, texto centrado) */
    .compartir-band {
        max-width: 760px;
        margin: 2.75rem auto 0;
        padding: 1.75rem 2rem;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        border: 1px solid var(--color-border-strong);
        border-top: 3px solid var(--color-brand);
        border-radius: 10px;
        background-color: rgba(255, 42, 42, 0.04);
    }

    .compartir-band h3 {
        font-size: 1.15rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin: 0;
        color: var(--color-text);
    }

    .compartir-band .compartir-sub {
        max-width: 540px;
    }

    .compartir-sub {
        margin: 0;
        color: var(--color-text-muted);
        font-size: 0.92rem;
        line-height: 1.65;
    }

    .compartir-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        margin-top: 0.9rem;
        color: var(--color-brand);
        text-decoration: none;
        font-weight: 800;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.8px;
        border: 1px solid rgba(255, 42, 42, 0.35);
        padding: 0.65rem 1.3rem;
        border-radius: 4px;
        transition:
            background-color 0.2s,
            color 0.2s,
            transform 0.2s;
    }

    .compartir-cta:hover {
        background-color: var(--color-brand);
        color: var(--color-text);
        transform: translateY(-2px);
    }

    /* Banner IG / comunidad: barra horizontal a lo ancho, cierre de la
       sección — head a la izquierda, chips al centro, CTA a la derecha */
    .comunidad-card {
        background:
            radial-gradient(
                circle at 50% 0%,
                rgba(255, 42, 42, 0.14) 0%,
                transparent 60%
            ),
            var(--color-surface);
        border: 1px solid var(--color-border-strong);
        border-radius: 12px;
        padding: 1.5rem 1.75rem;
        margin-top: 1.5rem;
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 1.5rem;
        transition:
            border-color 0.25s ease,
            transform 0.25s cubic-bezier(0.2, 0.8, 0.3, 1),
            opacity 0.7s cubic-bezier(0.2, 0.8, 0.3, 1);
    }

    .comunidad-card:hover {
        border-color: var(--color-border-hover);
        transform: translateY(-3px);
    }

    .comunidad-head {
        display: flex;
        align-items: center;
        gap: 0.9rem;
    }

    .comunidad-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 50px;
        height: 50px;
        border-radius: 8px;
        color: var(--color-text);
        background-color: var(--color-surface-raised);
        border: 1px solid var(--color-border-hover);
    }

    .comunidad-head h3 {
        font-size: 1.1rem;
        font-weight: 900;
        text-transform: uppercase;
        margin: 0;
    }

    .comunidad-head p {
        color: var(--color-text-muted);
        font-size: 0.85rem;
        margin: 0.15rem 0 0;
    }

    .highlight-chips {
        flex: 1;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .chip {
        color: var(--color-text-muted);
        text-decoration: none;
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border: 1px solid var(--color-border-hover);
        background-color: var(--color-background-deep);
        padding: 0.4rem 0.75rem;
        border-radius: 100px;
        transition:
            color 0.2s ease,
            border-color 0.2s ease,
            transform 0.2s ease;
    }

    .chip:hover {
        color: var(--color-brand);
        border-color: var(--color-brand);
        transform: translateY(-2px);
    }

    .comunidad-cta {
        margin-left: auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        background-color: var(--color-brand);
        color: var(--color-text);
        text-decoration: none;
        font-weight: 800;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
        padding: 0.85rem 1.5rem;
        border-radius: 4px;
        transition:
            background-color 0.2s,
            transform 0.2s,
            box-shadow 0.2s;
    }

    .comunidad-cta:hover {
        background-color: var(--color-brand-hover);
        transform: translateY(-2px);
        box-shadow: 0 8px 22px var(--color-brand-shadow);
    }

    /* ====== RESPONSIVE ====== */
    @media (max-width: 980px) {
        .historias-top {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 760px) {
        .comunidad-card {
            flex-direction: column;
            align-items: flex-start;
            gap: 1.1rem;
        }

        .comunidad-cta {
            margin-left: 0;
            align-self: stretch;
            justify-content: center;
        }
    }

    @media (max-width: 640px) {
        .resultados-section {
            padding: 4.5rem 1.25rem;
        }

        h2 {
            font-size: 1.9rem;
        }

        .compartir-band {
            padding: 1.5rem 1.25rem;
        }
    }
</style>
