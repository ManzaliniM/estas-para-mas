---
// src/pages/index.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Manifiesto from "../components/Manifiesto.astro";
import Actividades from "../components/Actividades.astro";
import ProximosObjetivos from "../components/ProximosObjetivos.astro";
import SobreMariano from "../components/SobreMariano.astro";
import Comunidad from "../components/Comunidad.astro";
import PreguntasFrecuentes from "../components/PreguntasFrecuentes.astro";
import Contacto from "../components/Contacto.astro";
import MarqueeSponsors from "../components/MarqueeSponsors.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
	title="Estás Para Más | Gimnasio y entrenamiento en Tandil"
	description="Entrenamiento en Tandil para todos los niveles: gimnasio, caminata y trote, ciclismo y natación. Desde empezar a moverte hasta preparar un triatlón."
>
	<!-- Encabezado de Navegación Global -->
	<Header />

	<main>
		<!-- 1. Banner Principal de Impacto -->
		<Hero />

		<!-- 2. ¿Qué significa "Estás Para Más"? Valores del grupo -->
		<Manifiesto />

		<!-- 3. Grilla con las Actividades, Horarios, Lugares y Agenda semanal -->
		<Actividades />

		<!-- 4. Metas del grupo en el calendario -->
		<ProximosObjetivos />

		<!-- 5. Trayectoria y Credenciales del Profesor Mariano -->
		<SobreMariano />

		<!-- 6. Prensa, entrevista, testimonios e Instagram del grupo -->
		<Comunidad />

		<!-- 7. Bloque interactivo de Preguntas Frecuentes -->
		<PreguntasFrecuentes />

		<!-- 8. Canales de contacto directo con Mariano -->
		<Contacto />
	</main>

	<!-- Marquee de Sponsors -->
	<MarqueeSponsors />

	<!-- Pie de Página Global -->
	<Footer />
</BaseLayout>
